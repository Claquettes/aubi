# ── Les deux valeurs à régler ────────────────────────────────────────────────

# Mot de passe de la base de données. Inventez-en un, il ne quitte pas la machine.
AUBI_DB_PASSWORD=changeme_mot_de_passe_solide

# Racine explorable : le dossier que le serveur a le droit de voir. Vous
# choisirez ensuite depuis l'application quels sous-dossiers indexer. Il est
# monté à l'identique dans le conteneur, donc le chemin affiché dans
# l'interface est le vrai chemin de votre machine.
#   un seul dossier de musique      → /home/vous/Musique
#   plusieurs dossiers séparés      → leur parent commun, /home/vous
#   plusieurs disques               → leur point de montage commun, /mnt
AUBI_MEDIA_ROOT=/home/vous/Musique


# ── Optionnel ────────────────────────────────────────────────────────────────

# Port de l'interface en installation autonome (docker-compose.standalone.yml).
# AUBI_PORT=8080

# Domaine, uniquement pour l'installation derrière Traefik (docker-compose.yml).
# L'application répond alors sur https://aubi.${DOMAIN}
# DOMAIN=example.com
